{
  "name": "quarto-live-poll",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Live polls and word clouds for Quarto revealjs decks, with a Cloudflare or Docker backend",
  "license": "MIT",
  "scripts": {
    "build": "bun run build:deck && bun run build:audience && bun run build:node",
    "build:deck": "bun build src/deck/plugin.ts --target=browser --format=iife --outfile=_extensions/live-poll/live-poll.js",
    "build:audience": "bun build src/audience/vote.ts --target=browser --format=iife --outfile=public/vote.js",
    "build:node": "bun build src/server/node/main.ts --target=node --outfile=dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/node-ws": "^1.3.1",
    "hono": "^4.13.13",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.150.0"
  }
}
