{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "live-questions",
  "main": "src/server/cloudflare/worker.ts",
  "compatibility_date": "2026-10-01",

  // Bundles the audience page script into public/ before every dev/deploy.
  "build": {
    "command": "bun run build:audience",
    "watch_dir": "src/audience"
  },

  // The audience page. The Worker handles the HTML routes (so it can check
  // session names and set security headers) and the API; vote.js and
  // vote.css are served straight from the asset store.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/s/*", "/api/*", "/healthz"]
  },

  // One SQLite-backed Durable Object per session (available on the free plan).
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "SessionRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionRoom"] }],

  "observability": { "enabled": true }

  // Secret: `bunx wrangler secret put PRESENTER_KEY`.
  // For `wrangler dev`, copy .dev.vars.example to .dev.vars.
}
